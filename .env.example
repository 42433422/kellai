# 客来来是随 XCMAX 使用的本机账号与通道工具。
KELLAI_PORT=8793
KELLAI_HOST=127.0.0.1
KELLAI_LOG_LEVEL=INFO
KELLAI_XCMAX_API_BASE=http://127.0.0.1:17500

# 历史数据存在多个工作区时必须明确选择，不会合并或猜测归属。
# KELLAI_WORKSPACE_ID=1
# KELLAI_DATA_DIR=/absolute/path/to/kellai-data

# 桌面默认使用操作系统 keyring 保存主密钥。
# 无原生安全 keyring 的部署，注入持久、受保护的 Fernet 密钥。
# 使用 cryptography.fernet.Fernet.generate_key() 生成；不得提交仓库或放前端。
# 密钥遗失后无法恢复密文，切勿每次启动重新生成。
KELLAI_VAULT_KEY=

# 回调须在服务商的 OAuth 应用中登记；桌面默认使用当前本机服务地址。
# KELLAI_OAUTH_CALLBACK_URL=http://127.0.0.1:8793/api/kellai/accounts/oauth/callback

# 只同步通道入站，不生成业务回复。
KELLAI_CHANNEL_WORKER_ENABLED=1
VITE_API_BASE_URL=http://127.0.0.1:8793
